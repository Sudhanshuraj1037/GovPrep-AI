# GovPrep-AI backend configuration.
# Copy this file to backend/.env and fill in real values. backend/.env is git-ignored: never commit it.

# --- Existing settings -------------------------------------------------------
# Groq API key (https://console.groq.com). NOTE: the server needs a value here to start; the OpenAI SDK it
# uses refuses to start with none. For NLP-only local work any non-empty placeholder lets it boot, but the
# question generator and assistant will then fail when they call Groq.
GROQ_API_KEY=your-groq-api-key-here
# Optional: override the Groq model (the code has its own default).
# GROQ_MODEL=openai/gpt-oss-20b

# Secret used to sign login tokens. Use a long random string. If this is missing the server falls back to a
# built-in development secret, which must never be used in production.
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000

# --- NLP service (Phase 8) ---------------------------------------------------
# Base URL of the Python NLP service. Leave it unset to run GovPrep-AI without the NLP features: /api/nlp/*
# then answers 503 "nlp_service_not_configured" and everything else works as before.
# Local development: start the service on this address (see docs/NLP_INTEGRATION.md).
NLP_SERVICE_URL=http://127.0.0.1:8001
# Timeouts in milliseconds. SLOW applies to BERT classification, t-SNE and the model comparison.
NLP_TIMEOUT_MS=15000
NLP_SLOW_TIMEOUT_MS=60000
# Largest JSON request body /api/nlp accepts, in KB (other routes keep Express's 100 KB default).
NLP_MAX_BODY_KB=1024
